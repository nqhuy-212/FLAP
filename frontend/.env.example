# frontend/.env.example — copy thành frontend/.env.development.local (đã gitignore).
#
# QUAN TRỌNG: dùng đúng ".env.development.local", KHÔNG dùng ".env.local" — Next.js
# nạp ".env.local" ở CẢ `next dev` lẫn `next build`, trong khi ".env.development.local"
# chỉ nạp khi NODE_ENV=development (tức `next dev`). Build production (static export
# nhúng vào FastAPI — CLAUDE.md quyết định #3) phải để trống biến này để dùng URL
# tương đối (cùng origin), nếu lỡ dùng ".env.local" thì URL dev sẽ bị đóng băng vào
# bundle production.

# URL backend khi chạy `next dev` (frontend port riêng, backend port riêng — không cùng origin).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
