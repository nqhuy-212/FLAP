# FLAP Dashboard — mẫu biến môi trường. Copy thành ".env" (đã gitignore) rồi chỉnh giá trị thật.
# Xem CLAUDE.md mục 7. Đường dẫn tương đối được tính từ gốc dự án (thư mục chứa file .env này).

# Cổng phục vụ — xem bảng cấp phát port ở CLAUDE.md mục 3
FLAP_PORT=8080

# Thư mục chứa 5 file Excel nguồn (mặc định "EXCEL files" cạnh .env — chỉ cần đổi nếu di chuyển)
FLAP_DATA_DIR=EXCEL files

# Thư mục lưu snapshot Parquet lịch sử (mặc định "data/history" cạnh .env)
FLAP_HISTORY_DIR=data/history

# Thư mục ghi log xoay vòng (mặc định "logs" cạnh .env)
FLAP_LOG_DIR=logs

# Tiền tố route khi chạy sau reverse proxy nhiều dashboard chung 1 port (để trống nếu chạy độc lập)
FLAP_BASE_PATH=

# Nguồn dữ liệu: "excel" (giai đoạn 1, mặc định) hoặc "sql" (giai đoạn 2, xem Bước 9)
FLAP_DATASOURCE=excel

# Origin được phép gọi API lúc dev (frontend `next dev` port riêng gọi sang backend port riêng).
# Nhiều origin cách nhau bằng dấu phẩy. Production không cần (cùng origin — quyết định #3).
FLAP_CORS_ORIGINS=http://localhost:3000

# Token bảo vệ trang /pc/system (xem trạng thái + log không cần Terminal).
# BẮT BUỘC đặt giá trị riêng trước khi chạy trên LAN nhà máy — log chứa tên
# thật nhân viên (Relaxed_3.1.xlsx). Để trống = tắt hẳn endpoint (503).
FLAP_SYSTEM_TOKEN=
